# Server
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------
# Deployment shape
#
# PUBLIC_DEPLOYMENT is the switch that separates "my laptop" from "a machine
# strangers can reach". Leave it off locally and nothing below applies.
#
# Turn it on and src/config/preflight.js refuses to start unless JWT_SECRET,
# DB_PASSWORD, CORS_ORIGINS and API_ACCESS_KEY are all set properly. It is
# deliberately NOT tied to NODE_ENV, because this deployment runs with
# NODE_ENV=development on purpose: that is what keeps the one-time code coming
# back in the response so people can sign in while no SMS provider is wired up.
# That single decision must not drag the rest of the development defaults onto
# the internet with it.
# ---------------------------------------------------------------------
# PUBLIC_DEPLOYMENT=true

# Where the admin console is served from, comma separated. Anything else is
# refused by CORS, so a page on another domain cannot drive this API using a
# signed-in admin's browser.
# CORS_ORIGINS=https://d111111abcdef8.cloudfront.net

# A shared key every caller must send in the X-Sathiyaa-Key header. It is baked
# into the two APKs and the console bundle, so treat it as "keeps scanners out",
# not as a secret. Generate one:  openssl rand -base64 36
# API_ACCESS_KEY=

# How many proxies sit in front of this process. 1 behind CloudFront or an ALB,
# 0 when nothing is in front. Getting it wrong makes rate limiting count every
# request against the proxy's address instead of the caller's.
# TRUST_PROXY_HOPS=1

# The seeded super-admin. Set these BEFORE running the seed on any machine
# other than your own — the fallback is the password printed in the repository.
# Rotate an existing one with:
#   node scripts/set-admin-password.mjs admin@sathiyaa.com "new password"
# ADMIN_EMAIL=admin@sathiyaa.com
# ADMIN_PASSWORD=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sathiyaa
DB_USER=sathiyaa_app
DB_PASSWORD="your-local-mysql-password"   # placeholder: set a real one in .env, which is gitignored

# TLS to the database. Leave off against a MySQL on this machine; turn it on
# whenever the database is somewhere else, and always on RDS — it can be set to
# refuse unencrypted connections outright, and the password crosses the network
# either way.
#
# DB_SSL_CA is what makes it verification rather than just encryption. Get the
# bundle on the server with:
#   curl -o /opt/sathiyaa/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL=true
# DB_SSL_CA=/opt/sathiyaa/global-bundle.pem

# JWT
#
# Anyone with this can sign a token that says role=admin. On a public
# deployment preflight refuses to start on the placeholder, on anything under
# 32 characters, and on nothing at all.  openssl rand -base64 48
JWT_SECRET=change-this-in-production-please
JWT_EXPIRES_IN=7d

# OTP
OTP_TTL_MINUTES=10

# Booking
BOOKING_PAYMENT_WINDOW_MINUTES=15
BOOKING_REQUEST_STALE_MINUTES=30
START_SERVICE_GEOFENCE_KM=0.5

# Uploads
# Where photos and documents are written. Defaults to backend/uploads/.
# UPLOAD_DIR=/var/lib/sathiyaa/uploads

# ---------------------------------------------------------------------
# Integrations
#
# Every one of these defaults to a stub, so the whole platform runs with no
# accounts, no keys and no bills. The real adapters are written and tested —
# set the provider name and its keys and the same code paths go live. If a
# provider is named but its keys are missing, the server refuses to start and
# says which variable is missing.
# ---------------------------------------------------------------------

# Payments — stub | razorpay
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx      (start with the rzp_test_ keys)
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP — stub | msg91 | twilio
# NOTE (India): transactional SMS needs DLT registration of the sender id and
# every template before it will deliver. That approval takes 1-2 weeks and is
# a business process, not a code change. Until it clears, leave this unset and
# the OTP keeps coming back in the API response for testing.
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SMS_TEMPLATE_ID=
# --- or ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Face matching — stub | rekognition | azure
#
# rekognition is the one to use. CompareFaces is generally available: an IAM
# user with one permission and it works today. It costs $0.001 per image
# after the first 5,000 a month, which are free for the first twelve months,
# so a thousand arrival checks a month is about a dollar. The full setup is in
# docs/AWS-REKOGNITION.md.
#
# The key pair below belongs to an IAM user with ONE permission
# (rekognition:CompareFaces) and nothing else, so a leaked key cannot touch
# the database, the bucket or the bill beyond that one call.
# FACE_PROVIDER=rekognition
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FACE_MATCH_THRESHOLD=0.6
# FACE_TIMEOUT_MS=12000
#
# Azure is the alternative, and the slower road: Face verification is a
# Limited Access feature, so Microsoft must approve a written application
# describing the use case before the endpoint will answer at all.
# FACE_PROVIDER=azure
# AZURE_FACE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_FACE_KEY=
# FACE_MATCH_THRESHOLD=0.6

# Maps — stub | osm | google
#
# osm is the one to use, and the one the deployment runs: real geocoding
# (Nominatim) and real road routing (OSRM), no account, no key, no bill. It is
# not a stub — Koramangala to MG Road comes back as 7.3 km by road against a
# 5.2 km straight line, which is the difference between a route and a guess.
MAPS_PROVIDER=osm
#
# Switch to google only when live traffic is worth paying for. Needs the
# Geocoding API and the Directions API enabled and billing switched on; restrict
# the key to those two APIs and to this server's IP.
# MAPS_PROVIDER=google
# GOOGLE_MAPS_API_KEY=

# Push notifications — stub | fcm
# All three values come from one Firebase service-account JSON file.
# Keep the newlines in the private key escaped as 
.
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"

# Masked calling — stub | exotel
# CALL_PROVIDER=exotel
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_CALLER_ID=
# EXOTEL_SUBDOMAIN=api.exotel.com
