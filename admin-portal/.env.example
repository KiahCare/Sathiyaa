# Copy this file to .env (or .env.local) and adjust as needed.

# Base URL of the Sathiyaa backend REST API (see docs/api-contract.md).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# When true (the default if unset), the app runs entirely against an
# in-memory mock data layer (src/api/mockData.ts + src/api/services.ts)
# instead of the real backend, so every screen is populated and clickable
# without a running server. Set to "false" to talk to the real backend.
VITE_USE_MOCK=true

# The shared key the API requires on every call when PUBLIC_DEPLOYMENT is on.
# Must match API_ACCESS_KEY in backend/.env.
#
# Vite bakes this into the bundle at build time, so it is readable by anyone
# who opens devtools. That is understood — see src/api/client.ts. It also means
# changing it needs a rebuild and redeploy, not just a restart.
# VITE_API_ACCESS_KEY=
